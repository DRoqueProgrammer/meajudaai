NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
NEXT_PUBLIC_APP_NAME=MeAjuda Aí

# Origem canônica do app. Em dev pode ficar vazia (cai no cabeçalho `origin`).
# Em produção é OBRIGATÓRIA: é ela que monta o link de recuperação de senha, e
# o valor precisa bater com a allow-list de Redirect URLs do Supabase.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# NÃO coloque RUN_INTEGRATION aqui nem no .env.local: os testes de integração
# criam usuários reais no Supabase, e o gate só funciona se vier da invocação.
# Para rodá-los de propósito: npm run test:integration

# Segredo do cron de lembrete de avaliação (GET /api/cron/lembretes-avaliacao).
# O endpoint só roda com `Authorization: Bearer <este valor>`. O Vercel Cron manda
# esse header automaticamente quando a env existe; sem ela, o endpoint recusa.
CRON_SECRET=uma-string-aleatoria-longa

