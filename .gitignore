# Rascunhos de ícone (opções para escolher, não fazem parte do app)
/design/icon-options

# Cache local do Supabase CLI (project-ref, versões, url do pooler) — por máquina, não versionar
/supabase/.temp

# Converge/Task-Spec: .agents/ NÃO é espelho descartável — é o tool home que o
# CLI `cvg` executa (ele procura .agents antes de .claude ao subir a árvore, ver
# `resolve_home` em bin/cvg). Fica versionado junto com .claude/skills/, senão um
# clone novo tem as skills mas o CLI quebra. Já o /.grok atende só o Grok Build,
# que não usamos; regenerável com o install.sh do Converge.
/.grok
/coverage

# Cache do Python gerado pelos scripts das skills (.agents/) — por máquina, não versionar
__pycache__/

# Worktrees temporárias dos agentes executores (Agent tool) — não versionar
/.claude/worktrees/

# Vínculo local com o projeto do Vercel (vercel link) — por máquina, não versionar
.vercel
